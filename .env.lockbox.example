# ═════════════════════════════════════════════════════════════════════════════
#  Level 3 (YC Lockbox) .env — секреты в Yandex Lockbox, не на диске.
#
#  Минимальный файл: только инфраструктурные идентификаторы + путь к
#  авторизованному ключу сервисного аккаунта + ID секрета в Lockbox.
#  Всё остальное (JWT_SECRET_KEY, API_KEY, ADMIN_API_KEY, S3-ключи 4 зон,
#  DATABASE_URL, BACKUP_PASSPHRASE и т.д.) живёт в Lockbox-секрете и
#  подтягивается через src/auth/lockbox_agent.py.
#
#  Преимущества перед Vault-путём:
#    • Lockbox не запечатывают — после reboot'а приложение просто
#      аутентифицируется и читает секреты. Zero touch.
#    • Без отдельного KMS-провайдера для auto-unseal.
#    • YC IAM как стандартный access control.
#
#  Недостатки:
#    • Vendor lock на YC (код через REST API).
#    • На диске остаётся авторизованный ключ сервисного аккаунта
#      (JSON-файл). Минимизация ущерба: роль `lockbox.payloadViewer` —
#      SA может только читать конкретный секрет, ничего больше.
# ═════════════════════════════════════════════════════════════════════════════

APP_ENV=production

# ── Инфраструктурные identifier'ы (не секреты) ────────────────
STORAGE_BACKEND=s3
CONFIG_PATH=configs/config.yaml
ARTIFACTS_DIR=/data/artifacts

API_DOMAIN=api.example.com
WEB_DOMAIN=web.example.com
CERTBOT_EMAIL=ops@example.com
CERTBOT_STAGING=0
ADMIN_CIDR=<YOUR_IP>/32

FRONTEND_ORIGINS=https://web.example.com

MAX_UPLOAD_BYTES=52428800
ALLOW_SYNC_UPLOAD_FALLBACK=0

# ── Yandex Lockbox ─────────────────────────────────────────────
# Создаётся один раз через scripts/lockbox_load_env.sh (см. DEPLOY.md §4.3).
# Этот ID не является секретом сам по себе — без SA-ключа он бесполезен.
YC_LOCKBOX_SECRET_ID=

# Эндпоинты можно оставить пустыми — используются дефолты YC.
# YC_LOCKBOX_ENDPOINT=payload.lockbox.api.cloud.yandex.net
# YC_IAM_ENDPOINT=iam.api.cloud.yandex.net

# Путь к SA-ключу внутри контейнера API/worker. Сам JSON-файл
# монтируется как read-only volume (КАТАЛОГ secrets/yc, не файл — #190/#303).
# (см. docker-compose.lockbox.yml).
YC_SA_KEY_FILE=/run/secrets/yc/yc-sa-key.json

# ── Email-OTP signup (Phase 7) ─────────────────────────────────
# Способ доставки писем с OTP-кодом для self-service регистрации.
#   console — печатает код в логи (только dev!)
#   resend  — REST API resend.com (рекомендую для prod)
#   smtp    — обычный SMTP relay
EMAIL_PROVIDER=resend
EMAIL_FROM=noreply@example.com
EMAIL_FROM_NAME=SKU Forecasting

# Только для EMAIL_PROVIDER=resend
RESEND_API_KEY=

# Только для EMAIL_PROVIDER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=1

# OTP-параметры
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5

# ── Cloudflare Turnstile (captcha на signup/login) ──────────────
# Создать Site в Cloudflare Dashboard → Turnstile (бесплатно).
TURNSTILE_SECRET_KEY=
# В dev можно отключить captcha. В production — НИКОГДА.
DISABLE_CAPTCHA=0

# ── OAuth провайдеры (Phase 8) ──────────────────────────────────
# Каждый провайдер активируется по ДВУМ условиям:
#   OAUTH_<NAME>_ENABLED=1
#   + полные креды (CLIENT_ID + SECRET + REDIRECT_URI)
# Если хоть одно отсутствует — провайдер не отдаётся фронту в
# /auth/oauth/providers, кнопка не рендерится. Чтобы отключить —
# поставить ENABLED=0 (creds можно оставить, прятать в Lockbox).

# Куда фронт ведёт юзера после успешного callback'а.
# Адрес НА ФРОНТЕ (web.example.com), не на бэке.
FRONTEND_OAUTH_RETURN_URL=https://web.example.com/oauth/return

# ── Google ──────────────────────────────────────────────────────
# Setup: console.cloud.google.com → APIs & Services → Credentials
#        → "OAuth client" → "Web application"
#        Authorized redirect URI:
#          https://api.example.com/auth/oauth/google/callback
OAUTH_GOOGLE_ENABLED=0
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_GOOGLE_REDIRECT_URI=https://api.example.com/auth/oauth/google/callback

# ── Yandex ──────────────────────────────────────────────────────
# Setup: oauth.yandex.ru → "Зарегистрировать приложение"
#        Платформа: "Веб-сервисы"
#        Callback URL: https://api.example.com/auth/oauth/yandex/callback
#        Доступы: "Адрес электронной почты", "Имя пользователя"
OAUTH_YANDEX_ENABLED=0
OAUTH_YANDEX_CLIENT_ID=
OAUTH_YANDEX_CLIENT_SECRET=
OAUTH_YANDEX_REDIRECT_URI=https://api.example.com/auth/oauth/yandex/callback
