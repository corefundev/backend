# Custom mlflow image — bakes Lockbox-bootstrap deps so the container
# fetches its dedicated S3 credentials (S3_MLFLOW_*) from Yandex Lockbox
# at startup and maps them to the AWS_*/MLFLOW_S3_ENDPOINT_URL env that
# mlflow's S3 client expects. Closes R8-12: the previous config pointed
# at MinIO (`minio:9000`) which is profile-disabled in prod, so artifact
# upload silently failed and `mlflow_run_id` stayed NULL.
#
# Why a custom image vs upstream ghcr.io/mlflow/mlflow:
#   Upstream is Debian-slim and CAN run shell — but it has no curl/jq
#   and the api/worker AWS_* (main client-data bucket) would clash if
#   we set AWS_* via compose env. Wrapping with lockbox_bootstrap +
#   an in-process rename (S3_MLFLOW_* → AWS_*) gives mlflow its own
#   credentials, fetched at runtime, never on disk in /srv/backend/.env.
#
# Same Lockbox-fetch pattern as backup / alertmanager / postgres-exporter
# / pgbouncer / prometheus (R10-S6). Allowlist gates injection to ONLY
# the 5 S3_MLFLOW_* keys so mlflow never sees the other 89 secrets.

FROM ghcr.io/mlflow/mlflow:v3.11.1@sha256:6cb0a22c0d4d722a793c2e93d89ba28b10b6b27d4c1e60ab2533a8e081ffca2d

# Image USER stays root, but ONLY for the entrypoint's bootstrap phase
# (lockbox_bootstrap must read the bind-mounted SA key, deploy-owned
# mode 644). R12-#86 — gosu + a dedicated system user let the
# entrypoint drop privileges before exec'ing the mlflow server, so the
# network-facing process never runs as root. Compose pairs this with
# cap_drop ALL + SETUID/SETGID + no-new-privileges.
USER root
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
        curl \
        jq \
        openssl \
        coreutils \
        ca-certificates \
        gosu \
 && rm -rf /var/lib/apt/lists/* \
 && useradd --system --uid 990 --user-group --create-home --home-dir /home/mlflow \
            --shell /usr/sbin/nologin mlflow

# The official ghcr.io/mlflow/mlflow image ships intentionally skinny —
# only the core mlflow venv. Anything beyond file-backed sqlite needs
# to be added explicitly. We need TWO extras for the R8-12 setup:
#
#   * `boto3` — S3 client for `--serve-artifacts` + S3 artifact
#     destinations. Without it, the first artifact upload via
#     `mlflow-artifacts:/` returns 500 with `ModuleNotFoundError:
#     No module named 'boto3'` — the exact R8-12 failure mode in a
#     different shape. 1.34+ is required for SigV4 against custom
#     endpoints (Selectel). Bounded `<2` major prevents an
#     unattended 2.x bump from breaking the artifact path.
#
#   * `psycopg2-binary` — the postgres dialect for SQLAlchemy. The
#     mlflow image historically pointed at sqlite, hence skinny. We
#     now point `--backend-store-uri postgresql://…` so mlflow shares
#     run state with the app DB. Without psycopg2, the mlflow server
#     crashes at boot with `ModuleNotFoundError: No module named
#     'psycopg2'` inside sqlalchemy.dialects.postgresql.psycopg2 — the
#     mlflow:5000 service is unreachable, workers' mlflow.start_run()
#     errors → `mlflow_run_id` NULL → R8-12 propagates regardless of
#     whether S3 is reachable. `-binary` avoids needing libpq-dev /
#     gcc at build time; the runtime cost is identical for our use.
RUN pip install --no-cache-dir \
        'boto3>=1.34,<2' \
        'psycopg2-binary>=2.9,<3'

# Lockbox secret-loader (shared with backup / alertmanager / postgres-
# exporter / pgbouncer / prometheus).
COPY scripts/lockbox_bootstrap.sh /usr/local/bin/lockbox_bootstrap.sh

# Wrapper: optional Lockbox bootstrap, rename S3_MLFLOW_* → AWS_* +
# MLFLOW_S3_ENDPOINT_URL for the mlflow server's S3 client, exec mlflow.
COPY scripts/mlflow_entrypoint.sh /usr/local/bin/mlflow_entrypoint.sh

RUN chmod +x /usr/local/bin/lockbox_bootstrap.sh \
             /usr/local/bin/mlflow_entrypoint.sh

ENTRYPOINT ["/usr/local/bin/mlflow_entrypoint.sh"]
