# Custom autoheal sidecar — restarts containers labeled autoheal=true
# when they go unhealthy. Talks to Docker via DOCKER_HOST (set to the
# docker-socket-proxy in compose), so no direct /var/run/docker.sock
# mount is needed.
#
# Why custom: willfarrell/autoheal:1.2.0 is incompatible with TCP
# DOCKER_SOCK — see scripts/autoheal.py docstring + memory
# [[feedback_no_revert_to_known_bad]].
#
# 30MB final image (alpine + python + docker SDK), pinned digests.

FROM python:3.13-alpine3.20@sha256:fcbcbbecdeae71d3b77445d9144d1914df55110f825ab62b04a66c7c33c09373

# docker SDK — pinned. Latest 7.x as of 2026-05-30.
RUN pip install --no-cache-dir docker==7.1.0

COPY scripts/autoheal.py /app/autoheal.py
RUN chmod +x /app/autoheal.py

# Non-root for defense-in-depth (autoheal only needs to send HTTP to the
# proxy; no need for any host capability). nobody:65534 is the standard
# unprivileged user on alpine.
USER 65534:65534

# Liveness via heartbeat-file mtime — autoheal.py rewrites
# /run/autoheal.heartbeat after every successful poll. The probe is a
# pure-shell stat (no Python start, no docker-SDK import, no network):
# on this 0.1-CPU sidecar a cold `import docker` measured 5.6-6.5s,
# blowing the 5s timeout so the old `python -c …ping()` probe failed
# EVERY interval despite a healthy poller. A `stat` of the heartbeat is
# sub-second AND tests the poller's real liveness (a wedged poller or
# an unreachable proxy stops refreshing the file → unhealthy).
#
# start-period is generous (45s) so the slow cold start (python +
# import docker ~6s + first poll, all at 0.1 CPU) lands the first
# heartbeat before failures count. Stale threshold = 90s (3× the 30s
# poll interval) tolerates 2 missed polls before flagging.
HEALTHCHECK --interval=30s --timeout=5s --start-period=45s --retries=3 \
    CMD [ -f /run/autoheal.heartbeat ] && \
        [ "$(( $(date +%s) - $(stat -c %Y /run/autoheal.heartbeat) ))" -lt 90 ]

CMD ["python", "-u", "/app/autoheal.py"]
