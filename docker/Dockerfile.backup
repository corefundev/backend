# Backup container — runs nightly pg_dump + AES-256 + S3 upload via cron.
#
# Runtime self-bootstraps from Yandex Lockbox: each cron invocation
# runs `lockbox_bootstrap.sh` first, fetches fresh secrets via JWT/PS256
# → IAM token → Lockbox payload, exports them, then runs backup.sh.
# No reliance on compose-time `${VAR:-}` interpolation, no .env file
# leakage of secrets, no env baked into the container at create time.
#
# Why a dedicated Dockerfile (vs runtime apk-add on alpine:3.20):
#   The previous setup did `apk add postgresql-client openssl coreutils
#   dcron curl jq` + `curl mc` at container start. When alpine's CDN was
#   unreachable on a restart, install hung forever and crond never
#   started — that's exactly what killed nightly backups for 8 days
#   (#176). Baking deps at build time eliminates the runtime fragility.

# Stage 1: pull mc from official MinIO image — direct download from
# dl.min.io occasionally times out from this VPS's build network,
# Docker Hub is more reliable. Pinned to the version we were already
# running successfully via runtime curl.
FROM minio/mc:RELEASE.2025-08-13T08-35-41Z@sha256:a7fe349ef4bd8521fb8497f55c6042871b2ae640607cf99d9bede5e9bdf11727 AS mc-stage

FROM alpine:3.20@sha256:d9e853e87e55526f6b2917df91a2115c36dd7c696a35be12163d44e6e2a4b6bc

# Install everything backup.sh + lockbox_bootstrap.sh need. mc comes
# from the multi-stage COPY below — no runtime/build-time CDN curl.
RUN apk add --no-cache \
        postgresql-client \
        openssl \
        coreutils \
        dcron \
        curl \
        jq \
        ca-certificates

COPY --from=mc-stage /usr/bin/mc /usr/local/bin/mc

# lockbox_bootstrap.sh wraps any command, fetching Lockbox secrets
# first. backup.sh / base_backup.sh / audit_log_retention.sh come from
# the bind-mount at runtime (so we can tweak pipelines without
# rebuilding the image), but lockbox_bootstrap.sh + cron_wrapper.sh
# are baked here — they're stable and critical deps of the container
# starting cleanly.
COPY scripts/lockbox_bootstrap.sh       /usr/local/bin/lockbox_bootstrap.sh
COPY scripts/cron_wrapper.sh            /usr/local/bin/cron_wrapper.sh
COPY scripts/backup_metric_warmup.sh    /usr/local/bin/backup_metric_warmup.sh
RUN chmod +x /usr/local/bin/lockbox_bootstrap.sh \
             /usr/local/bin/cron_wrapper.sh \
             /usr/local/bin/backup_metric_warmup.sh

# Crontab. Every cron run does:
#   1. lockbox_bootstrap.sh — fetch fresh secrets (Lockbox JWT/IAM/payload)
#   2. cron_wrapper.sh <job> — push `sku_<job>_cron_fired_timestamp_seconds`
#      to pushgateway, then exec the real script
#   3. real script — backup.sh / base_backup.sh / audit_log_retention.sh
#
# The cron_wrapper.sh step isolates the cron-infrastructure-layer
# signal from the script-success-layer (R10 audit B3, 2026-05-28):
# manual recovery refreshes the success metric and masks cron drift,
# but the cron-fired metric only updates when cron actually fires.
# Stale cron-fired → BaseBackupCronSilent / BackupDailyCronSilent /
# AuditLogRetentionCronSilent alerts surface the drift.
# wal_mirror runs every 5 min (R10 B1) — off-region WAL reconcile to
# Selectel uz-2. NOT wrapped in cron_wrapper.sh (unlike the 3 above):
# WalMirrorStale (alerts.production.yml) watches the success metric
# `sku_wal_mirror_last_success_timestamp_seconds`, and a dead crond is
# already caught by the sibling *CronSilent alerts (shared crond). A
# dedicated cron_fired metric here would be unused → dead metric. The
# 5-min cadence is << WalMirrorStale's for:15m, so absent() on the
# success metric is storm-safe (the metric appears before the first
# for: window completes on a fresh deploy — see the alert's NOTE).
# archive_mode_check (R11-#80) runs every 5 min on the SAME pattern as
# wal_mirror — no cron_wrapper: it pushes its own freshness metric
# pg_archive_mode_check_timestamp_seconds (PostgresArchiveModeCheckStale
# watches it), and a dead crond is caught by the sibling *CronSilent
# alerts. It probes `SHOW archive_mode` and pushes pg_archive_mode_enabled
# {0|1} so PostgresArchiveModeOff fires when WAL archiving is disabled —
# the gap WalArchiveFailing/WalArchiveStale leave open (R11-#80b root cause).
# rotate_backup_logs (R12-#89) runs daily WITHOUT lockbox_bootstrap —
# it touches no secrets, only size-caps /var/log/*.log so the */5
# jobs (wal_mirror, archive_mode_check) can't slowly fill the layer.
RUN printf '%s\n%s\n%s\n%s\n%s\n%s\n%s\n' \
        "10 2 * * * /usr/local/bin/lockbox_bootstrap.sh /usr/local/bin/cron_wrapper.sh backup /scripts/backup.sh >> /var/log/backup.log 2>&1" \
        "30 3 * * 0 /usr/local/bin/lockbox_bootstrap.sh /usr/local/bin/cron_wrapper.sh base_backup /scripts/base_backup.sh >> /var/log/base_backup.log 2>&1" \
        "0  4 * * * /usr/local/bin/lockbox_bootstrap.sh /usr/local/bin/cron_wrapper.sh audit_log_retention /scripts/audit_log_retention.sh >> /var/log/audit_log_retention.log 2>&1" \
        "*/5 * * * * /usr/local/bin/lockbox_bootstrap.sh /scripts/wal_mirror.sh >> /var/log/wal_mirror.log 2>&1" \
        "0  5 * * * /usr/local/bin/lockbox_bootstrap.sh /scripts/mirror_prune.sh >> /var/log/mirror_prune.log 2>&1" \
        "*/5 * * * * /usr/local/bin/lockbox_bootstrap.sh /scripts/archive_mode_check.sh >> /var/log/archive_mode_check.log 2>&1" \
        "20 5 * * * /scripts/rotate_backup_logs.sh >> /var/log/rotate.log 2>&1" \
        | crontab - \
 && touch /var/log/backup.log /var/log/base_backup.log /var/log/audit_log_retention.log /var/log/wal_mirror.log /var/log/mirror_prune.log /var/log/archive_mode_check.log /var/log/rotate.log

# Foreground crond — image PID 1.
# Echo the "backup cron installed" sentinel so scripts/restart-backup
# workflow's wait-for-readiness loop still works.
#
# Startup warmup: BEFORE crond, run backup_metric_warmup.sh wrapped in
# lockbox_bootstrap.sh to re-push the REAL last-success timestamps (from
# S3) for backup / base_backup / mirror metrics. This closes the gap
# where a pushgateway recreate (deploy, host reboot, fresh volume) left
# `BackupStale` / `BaseBackupStale` / mirror-staleness alerts firing
# `absent(metric)` for up to 24h until the next natural cron tick, even
# though the actual backups were healthy in S3. Best-effort: a failed
# warmup logs + continues to crond — monitoring resilience must NEVER
# block the data path.
#
# R11-#97: backup stays root (cannot drop to nobody) — dcron's crond binary is
# mode 0700 root:root (verified: `-rwx------ root`), so only root can exec it,
# and it does setgid()+initgroups()+setuid() (ChangeUser) per job at runtime.
# Non-root crond fails with "crond: Permission denied". The hardening is
# Level 1: keep root but cap_drop ALL + no-new-privileges + cap_add
# SETGID,SETUID (see the backup service in docker-compose.yml). SETGID/SETUID
# are REQUIRED — without them crond's per-job initgroups()/setgroups(2) fails
# ("unable to ChangeUser") and ZERO cron jobs run, silently. Every other
# privileged kernel op is still dropped; the jobs themselves (pg_dump/openssl/
# mc/lockbox curl) need no further caps.
CMD ["sh", "-c", "echo 'backup cron installed; warming pushgateway from S3…' && /usr/local/bin/lockbox_bootstrap.sh /usr/local/bin/backup_metric_warmup.sh; echo 'warmup done; starting crond' && exec crond -f -L /var/log/backup.log"]
