# ─────────────────────────────────────────────────────────────────────────────
# Staging .env template. Copy to /srv/backend/.env on the staging VPS.
#
# All actual secrets (POSTGRES_PASSWORD, JWT_SECRET_KEY, S3_*, etc.) live
# in the Lockbox secret `sku-forecasting-staging-secrets` (folder
# `staging`, id e6qluj61sut7a2di7ljc) and are injected at container
# startup via lockbox_bootstrap.sh / vault_agent.bootstrap_secrets.
#
# This file holds only NON-SENSITIVE config: domain names, feature
# flags, infrastructure pointers. Safe to keep in git, safe in deploy
# logs, safe to leak.
# ─────────────────────────────────────────────────────────────────────────────

APP_ENV=staging

# Domain wiring — host nginx (compose-side) terminates TLS at these.
DOMAIN=api.staging.testcore.ru
API_DOMAIN=api.staging.testcore.ru
WEB_DOMAIN=staging.testcore.ru
FRONTEND_ORIGINS=https://staging.testcore.ru
CERTBOT_EMAIL=ops@testcore.ru
CERTBOT_STAGING=0
ADMIN_CIDR=127.0.0.1/32

# ── Lockbox bootstrap ────────────────────────────────────────────────
# YC service account key is mounted RO at /run/secrets/yc-sa-key.json.
# Lockbox payload viewer role on `sku-forecasting-staging-secrets` only.
YC_LOCKBOX_SECRET_ID=e6qluj61sut7a2di7ljc
YC_SA_KEY_FILE=/run/secrets/yc-sa-key.json

# ── Storage / app paths ──────────────────────────────────────────────
STORAGE_BACKEND=s3
ARTIFACTS_DIR=/data/artifacts
CONFIG_PATH=configs/config.yaml
MAX_UPLOAD_BYTES=52428800

# ── ClamAV (antivirus) ──────────────────────────────────────────────
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_SEC=60
CLAMAV_MAX_BYTES=52428800
ALLOW_SYNC_UPLOAD_FALLBACK=0

# ── Sandbox (process-worker) ────────────────────────────────────────
SANDBOX_IMAGE=sku-forecasting-sandbox
SANDBOX_TIMEOUT_SEC=30
SANDBOX_MEM_LIMIT=512m
SANDBOX_CPUS=1.0
SANDBOX_MAX_ROWS=5000000
SANDBOX_MAX_COLUMNS=64
SANDBOX_WORK_DIR=/srv/backend/sandbox-staging
SANDBOX_RUNTIME=runc

# ── Email (staging: console-only — OTP shows in api logs, no SMTP) ──
EMAIL_PROVIDER=console
EMAIL_FROM=noreply@testcore.ru
EMAIL_FROM_NAME="SKU Forecasting (staging)"
SMTP_PORT=587
SMTP_USE_TLS=1
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5

# ── Captcha (disabled on staging — speeds up smoke flow) ────────────
DISABLE_CAPTCHA=1

# ── OAuth (disabled on staging — no Google/Yandex client ids) ──────
OAUTH_GOOGLE_ENABLED=0
OAUTH_GOOGLE_REDIRECT_URI=https://api.staging.testcore.ru/auth/oauth/google/callback
OAUTH_YANDEX_ENABLED=0
OAUTH_YANDEX_REDIRECT_URI=https://api.staging.testcore.ru/auth/oauth/yandex/callback
FRONTEND_OAUTH_RETURN_URL=https://staging.testcore.ru/app

# ── Telegram alerts: re-using prod bot + group (cluster=staging label
#    distinguishes) — TELEGRAM_ALERT_BOT_TOKEN / CHAT_ID come from
#    Lockbox staging secret — keep them out of .env.
