# syntax=docker/dockerfile:1.6
# ═════════════════════════════════════════════════════════════════════════════
# Minimal sandbox image for untrusted CSV/XLSX parsing.
#
# Principles:
#   • Distroless-ish: only Python + the parser + its deps. No shell in final
#     image (python:3.11-slim keeps /bin/sh for pip; we strip it after).
#   • Non-root by construction: runs as `nobody` (uid 65534).
#   • Pinned deps with --no-deps to keep the dependency graph tiny.
#   • No project source — only secure_parser.py is copied in.
#
# Container runtime flags set by src/storage/sandbox.py:
#   --network none --read-only --cap-drop ALL --security-opt no-new-privileges
#   --user 65534:65534 --pids-limit 64 --memory 512m --cpus 1
#
# Build:
#   docker build -f docker/Dockerfile.sandbox -t sku-forecasting-sandbox ..
# ═════════════════════════════════════════════════════════════════════════════

FROM python:3.11-slim@sha256:a3ab0b966bc4e91546a033e22093cb840908979487a9fc0e6e38295747e49ac0 AS base

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /opt

# Audit Trivy 2026-05-16 — `apt-get upgrade -y` pulls debian security
# patches at every build (the floating python:3.11-slim base can lag
# behind freshly-disclosed CVEs). Same pattern as Dockerfile + .worker.
# `apt list` is intentionally empty after — the sandbox doesn't need
# any extra apt packages, but `upgrade` still applies pending patches.
RUN apt-get update \
    && apt-get upgrade -y --no-install-recommends \
    && rm -rf /var/lib/apt/lists/*

# Audit R4-19 (2026-05-17) — python:3.11-slim ships an older pip /
# setuptools / wheel triple that has bundled vulnerabilities in
# `setuptools/_vendor/`. Trivy on the rebuilt sandbox image surfaced:
#   - CVE-2026-23949 — jaraco.context 5.3.0 path-traversal via tar (HIGH)
#     (fixed in jaraco.context 6.1.0, bundled in setuptools >= 80)
#   - CVE-2026-24049 — wheel 0.45.1 RCE via malicious wheel file (HIGH)
#     (fixed in wheel 0.46.2)
# These ship with pip/setuptools, not our requirements, so they survive
# `apt-get upgrade` and `pip install -r requirements`. Identical fix
# already applied in Dockerfile + Dockerfile.worker — mirror here for
# enterprise cover-all-images consistency. Explicit jaraco.context pin
# guarantees the vendored copy is replaced even if setuptools 80+ ever
# regresses on the bundle.
RUN pip install --no-cache-dir --upgrade \
        pip \
        "setuptools>=80" \
        wheel==0.46.2 \
        jaraco.context==6.1.0

# Audit R3-19 — sandbox dependencies are pinned in
# docker/requirements-sandbox.txt (full transitive graph). The lockfile
# is git-tracked so trivy + pip-audit scan it at CI time, and parquet
# format compatibility with the training pipeline (R3-3) holds at the
# graph level — not just at the pyarrow leaf.
COPY docker/requirements-sandbox.txt /tmp/requirements-sandbox.txt
RUN pip install --no-cache-dir -r /tmp/requirements-sandbox.txt && \
    rm /tmp/requirements-sandbox.txt

COPY src/validation/secure_parser.py /opt/secure_parser.py

# Strip interactive shells — nothing in the sandbox should need them.
# We keep /bin/sh only if you need it for Docker exec debugging; comment
# out to go stricter.
RUN rm -f /bin/bash /bin/dash /usr/bin/perl /usr/bin/awk /usr/bin/ssh || true

# Drop privileges early (Docker will enforce --user too, but defense in depth).
USER 65534:65534

ENTRYPOINT ["python", "/opt/secure_parser.py"]
