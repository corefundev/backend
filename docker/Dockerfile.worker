# ══════════════════════════════════════════════════════
# SKU Forecasting Platform — Training Worker Image
# ══════════════════════════════════════════════════════
FROM python:3.11-slim

RUN groupadd -r sku && useradd -r -g sku -d /app -s /sbin/nologin sku

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
        gcc g++ libpq-dev \
    && rm -rf /var/lib/apt/lists/*

# Same bake-fix as docker/Dockerfile — pip + setuptools vendor old
# wheel + jaraco.context inside _vendor/, which Trivy flags. Bump
# setuptools to ≥80 + pip to latest so the vendored copies are
# patched too.
RUN pip install --no-cache-dir --upgrade \
        pip \
        "setuptools>=80" \
        wheel==0.46.2 \
        jaraco.context==6.1.0

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY src/ src/
COPY configs/ configs/
COPY scripts/ scripts/

RUN chown -R sku:sku /app
USER sku

CMD ["rq", "worker", "--url", "redis://redis:6379", "default"]
