# Custom alertmanager image — bakes Lockbox-bootstrap deps so the
# container fetches TELEGRAM_ALERT_BOT_TOKEN / TELEGRAM_ALERT_CHAT_ID
# directly from Yandex Lockbox at startup. Avoids ever writing the bot
# token to /srv/backend/.env.
#
# Why a custom image vs upstream prom/alertmanager:
#   The upstream image is busybox-based — no curl/jq/openssl, so
#   lockbox_bootstrap.sh (PS256-signed JWT → IAM → Lockbox payload)
#   can't run there. We rebase on alpine, install the few extra
#   packages, and copy the alertmanager binary from upstream.
#
# Pinned to v0.28.1 (Jan 2025) for `message_thread_id` support in
# telegram_configs — required by our forum-topic routing
# (alertmanager.yml). v0.27 silently rejects the field with
# "field message_thread_id not found in type config.plain".
#
# Same Lockbox-fetch pattern as the backup container (Dockerfile.backup).

FROM prom/alertmanager:v0.28.1 AS upstream

FROM alpine:3.20

RUN apk add --no-cache \
        curl \
        jq \
        openssl \
        coreutils \
        ca-certificates

# Alertmanager binary + bundled defaults from upstream.
COPY --from=upstream /bin/alertmanager /bin/alertmanager
COPY --from=upstream /bin/amtool       /bin/amtool

# Lockbox secret-loader (shared with backup container). Stable script,
# baked into the image.
COPY scripts/lockbox_bootstrap.sh /usr/local/bin/lockbox_bootstrap.sh

# Render-and-exec wrapper: optional Lockbox bootstrap, sed-render
# template, exec alertmanager.
COPY scripts/alertmanager_entrypoint.sh /usr/local/bin/alertmanager_entrypoint.sh

RUN chmod +x /usr/local/bin/lockbox_bootstrap.sh \
             /usr/local/bin/alertmanager_entrypoint.sh \
 && mkdir -p /alertmanager \
 && chown -R nobody:nobody /alertmanager

EXPOSE 9093
WORKDIR /alertmanager
USER nobody

ENTRYPOINT ["/usr/local/bin/alertmanager_entrypoint.sh"]
