# ═════════════════════════════════════════════════════════════════════════════
#  Level 3 .env — секреты в Vault, не на диске.
#
#  Этот файл содержит ТОЛЬКО:
#    • инфраструктурные идентификаторы (домены, почта, CORS) — не секреты
#    • VAULT_ROLE_ID — half-secret, стабильный
#    • VAULT_SECRET_ID — короткоживущий (10m), инжектируется перед каждым up
#    • creds самого Vault для auto-unseal (если используется awskms)
#
#  Всё остальное (JWT_SECRET_KEY, API_KEY, ADMIN_API_KEY, MODEL_SIGNING_KEY,
#  DATABASE_URL, BACKUP_PASSPHRASE, S3-ключи всех 4 зон и т.д.) лежит в
#  Vault KV по пути secret/sku-forecasting и подтягивается в os.environ
#  при старте приложения (src/auth/vault_agent.py).
# ═════════════════════════════════════════════════════════════════════════════

APP_ENV=production

# ── Инфраструктурные identifier'ы ─────────────────────────────
STORAGE_BACKEND=s3
CONFIG_PATH=configs/config.yaml
ARTIFACTS_DIR=/data/artifacts

API_DOMAIN=api.example.com
WEB_DOMAIN=web.example.com            # можно не задавать на бэк-VPS, frontend сам знает
CERTBOT_EMAIL=ops@example.com
CERTBOT_STAGING=0
ADMIN_CIDR=<YOUR_IP>/32

FRONTEND_ORIGINS=https://web.example.com

MAX_UPLOAD_BYTES=52428800
ALLOW_SYNC_UPLOAD_FALLBACK=0

# ── Vault: клиент (app → Vault) ───────────────────────────────
VAULT_ADDR=http://vault:8200
VAULT_PATH=sku-forecasting

# Выдаётся один раз при vault_init.sh. Не является секретом сам по себе —
# без живого SECRET_ID не даёт ничего.
VAULT_ROLE_ID=

# Инжектируется CI/CD перед каждым `docker compose up -d`. TTL 10 минут,
# одно использование. Команда для ручного прогона:
#   VAULT_SECRET_ID=$(./scripts/vault_rotate_secret_id.sh) docker compose up -d
VAULT_SECRET_ID=

# ── Vault: сам seal mode ──────────────────────────────────────
# manual  — Shamir 5/3 (после reboot'а оператор распечатывает вручную)
# awskms  — auto-unseal через AWS KMS (нужен AWS-аккаунт, ~$1/мес)
# transit — auto-unseal через другой (root) Vault
VAULT_SEAL_MODE=awskms

# ── AWS KMS creds (только если VAULT_SEAL_MODE=awskms) ────────
# Это НЕ те же ключи что для Beget S3 — это отдельный AWS-аккаунт ТОЛЬКО
# для KMS. IAM user нужен с kms:Encrypt + kms:Decrypt на одном CMK.
VAULT_AWSKMS_KEY_ID=
VAULT_AWS_REGION=eu-north-1
VAULT_AWS_ACCESS_KEY_ID=
VAULT_AWS_SECRET_ACCESS_KEY=

# ── Transit seal creds (только если VAULT_SEAL_MODE=transit) ──
VAULT_TRANSIT_ADDRESS=
VAULT_TRANSIT_TOKEN=
VAULT_TRANSIT_KEY_NAME=
VAULT_TRANSIT_MOUNT=transit/
