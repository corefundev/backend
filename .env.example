# ══════════════════════════════════════════════════════════════
# SKU Forecasting Platform v8.0 — шаблон переменных окружения
#
# ВАЖНО: В production .env используется ТОЛЬКО для Level 1 и Level 2.
# Для Level 3 (рекомендуется) этот файл вообще не нужен.
#
# Три уровня безопасности:
#
#  Level 1 (dev):  заполнить этот .env полностью, docker compose --env-file .env
#  Level 2 (staging): только VAULT_ADDR + VAULT_TOKEN, остальное из Vault
#  Level 3 (prod): только VAULT_ADDR + VAULT_ROLE_ID в docker-compose.yml,
#                  VAULT_SECRET_ID инжектирует CI/CD, .env НЕ НУЖЕН вообще
#
# НИКОГДА не коммитьте .env в git!
# ══════════════════════════════════════════════════════════════

# ── Окружение ─────────────────────────────────────────────────
APP_ENV=production   # production | development | test

# ══════════════════════════════════════════════════════════════
# LEVEL 3 (production) — только эти две переменные нужны в .env
# Всё остальное приходит из Vault автоматически
# ══════════════════════════════════════════════════════════════

# Адрес Vault (не секрет — просто адрес сервера, как DATABASE_HOST)
VAULT_ADDR=http://vault:8200

# role_id — полусекрет, не меняется, можно запечь в Docker образ
# Получить: vault read auth/approle/role/sku-forecasting/role-id
VAULT_ROLE_ID=

# secret_id — настоящий секрет. НЕ ХРАНИТЬ ЗДЕСЬ.
# Инжектируется CI/CD при каждом деплое (TTL 10 мин, одноразовый):
#   VAULT_SECRET_ID=$(vault write -field=secret_id -f auth/approle/role/sku-forecasting/secret-id)
#   docker compose up -d  # secret_id уничтожается после первого использования
VAULT_SECRET_ID=

# Путь к секретам в Vault KV v2
VAULT_PATH=sku-forecasting

# ══════════════════════════════════════════════════════════════
# LEVEL 2 (staging) — вместо AppRole можно использовать статический токен
# Менее безопасно: токен долгоживущий
# ══════════════════════════════════════════════════════════════
VAULT_TOKEN=

# ══════════════════════════════════════════════════════════════
# LEVEL 1 (dev/test only) — все секреты в .env
# В production эти значения должны быть ПУСТЫМИ (берутся из Vault)
# ══════════════════════════════════════════════════════════════

# Генерация: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=
JWT_EXPIRE_MINUTES=60
JWT_ALGORITHM=HS256

# Генерация: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=

# Отдельный ключ для админской консоли (смена тарифов, просмотр всех клиентов).
# Без него админ-эндпоинты недоступны из UI; можно оставить пустым в dev —
# тогда админ-роли не будет ни у кого, и админка покажет 403.
ADMIN_API_KEY=

# ── Хранилище ─────────────────────────────────────────────────
STORAGE_BACKEND=s3            # s3 | local
ARTIFACTS_DIR=/opt/sku-forecasting/artifacts   # для local режима

# ── S3 / Beget (секреты берутся из Vault в production) ───────
# Получить ключи: my.beget.com → Object Storage → Ключи доступа
S3_BUCKET=sku-forecasting              # processed-zone (модели, фичи, параллельно — default fallback)
S3_ENDPOINT_URL=https://s3.beget.com
AWS_ACCESS_KEY_ID=            # пусто = берётся из Vault
AWS_SECRET_ACCESS_KEY=        # пусто = берётся из Vault
AWS_DEFAULT_REGION=ru-1
S3_KEY_PREFIX=

# ── Secure upload zones — три независимых S3-аккаунта (Beget) ─
#
# Beget выдаёт один keypair на владельца Object Storage, поэтому каждая
# из трёх зон должна жить в ОТДЕЛЬНОМ S3-аккаунте Beget (или
# минимум — с отдельным keypair'ом, если провайдер это позволяет).
# Это не паранойя: компрометация одного ключа не должна дать доступ
# к двум другим зонам.
#
# Схема:
#   untrusted   — сырые загрузки; API пишет, scan-воркер читает+удаляет
#   quarantine  — чистые файлы после антивируса; sandbox читает ro
#   processed   — parquet после sandbox'а; training читает
#
# Каждая переменная падает на AWS_ACCESS_KEY_ID/S3_BUCKET/S3_ENDPOINT_URL
# как fallback — в dev (MinIO, один бакет) задаёте только их.

# Zone 1 — Untrusted
S3_UNTRUSTED_BUCKET=sku-forecasting-untrusted
S3_UNTRUSTED_ENDPOINT_URL=
S3_UNTRUSTED_ACCESS_KEY_ID=
S3_UNTRUSTED_SECRET_ACCESS_KEY=
S3_UNTRUSTED_REGION=
S3_UNTRUSTED_KEY_PREFIX=

# Zone 2 — Quarantine
S3_QUARANTINE_BUCKET=sku-forecasting-quarantine
S3_QUARANTINE_ENDPOINT_URL=
S3_QUARANTINE_ACCESS_KEY_ID=
S3_QUARANTINE_SECRET_ACCESS_KEY=
S3_QUARANTINE_REGION=
S3_QUARANTINE_KEY_PREFIX=

# Zone 3 — Processed
S3_PROCESSED_BUCKET=sku-forecasting-processed
S3_PROCESSED_ENDPOINT_URL=
S3_PROCESSED_ACCESS_KEY_ID=
S3_PROCESSED_SECRET_ACCESS_KEY=
S3_PROCESSED_REGION=
S3_PROCESSED_KEY_PREFIX=

# ── Upload limits ─────────────────────────────────────────────
MAX_UPLOAD_BYTES=52428800     # 50 MiB — верхняя граница размера CSV/XLSX

# ── ClamAV ────────────────────────────────────────────────────
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_SEC=60
CLAMAV_MAX_BYTES=52428800     # должен совпадать с StreamMaxLength в clamd.conf

# ── Sandbox (parser) ──────────────────────────────────────────
SANDBOX_IMAGE=sku-forecasting-sandbox
SANDBOX_TIMEOUT_SEC=30
SANDBOX_MEM_LIMIT=512m
SANDBOX_CPUS=1.0
SANDBOX_MAX_ROWS=5000000
SANDBOX_MAX_COLUMNS=64
SANDBOX_WORK_DIR=/var/lib/sku-sandbox
SANDBOX_RUNTIME=runc          # или "runsc" для gVisor (нужна установка)

# ── Model artifact HMAC signing ───────────────────────────────
# Генерация: python3 -c "import secrets; print(secrets.token_hex(32))"
# ОБЯЗАТЕЛЬНО в production — без этого ключа любой, кто получит доступ
# к S3, сможет подменить model.pkl и получить RCE при следующем predict.
MODEL_SIGNING_KEY=

# ── Sync fallback (dev only) ──────────────────────────────────
# Если Redis недоступен, scan/process выполняются в HTTP-воркере.
# В production оставить пустым (или "0") — иначе API-воркер будет
# висеть на сканах.
ALLOW_SYNC_UPLOAD_FALLBACK=0

# ── CORS (Phase 5) ────────────────────────────────────────────
# Список origin'ов фронта через запятую. Без wildcards в prod.
FRONTEND_ORIGINS=http://localhost:5173

# ── Backups (Phase 5) ─────────────────────────────────────────
# Шифрование pg_dump. Генерация: pwgen -s 48 или python -c "import secrets;print(secrets.token_urlsafe(48))"
BACKUP_PASSPHRASE=

# Бэкап-бакет ДОЛЖЕН жить на отдельном аккаунте Beget S3 (или хотя бы с
# собственным keypair'ом). Ключ бэкапа с write-only правами — компрометация
# processed-ключа не должна давать возможность удалить резервные копии.
# Пустые значения — fallback на AWS_* (не рекомендуется в prod).
S3_BACKUP_BUCKET=sku-forecasting-backups
S3_BACKUP_ENDPOINT_URL=
S3_BACKUP_ACCESS_KEY_ID=
S3_BACKUP_SECRET_ACCESS_KEY=
S3_BACKUP_REGION=

# ── TLS / nginx (production overlay) ──────────────────────────
# Нужны для docker-compose.prod.yml. Выпуск сертификата: scripts/init_tls.sh
API_DOMAIN=api.example.com
CERTBOT_EMAIL=ops@example.com
CERTBOT_STAGING=0            # "1" для тестового CA Let's Encrypt
# CIDR, откуда разрешён доступ к /metrics через публичный nginx.
# По умолчанию заблокировано всё, кроме localhost.
ADMIN_CIDR=127.0.0.1/32

# ── Email-OTP self-service signup (Phase 7) ───────────────────
# console (dev) | resend (prod) | smtp (fallback)
EMAIL_PROVIDER=console
EMAIL_FROM=noreply@example.com
EMAIL_FROM_NAME=SKU Forecasting
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=1
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5

# Cloudflare Turnstile — captcha на signup/login
TURNSTILE_SECRET_KEY=
DISABLE_CAPTCHA=1            # ОБЯЗАТЕЛЬНО 0 в production

# ── OAuth providers (Phase 8) ─────────────────────────────────
# Двойной gate: ENABLED=1 + полные creds.
FRONTEND_OAUTH_RETURN_URL=http://localhost:5173/oauth/return

OAUTH_GOOGLE_ENABLED=0
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_GOOGLE_REDIRECT_URI=http://localhost:8000/auth/oauth/google/callback

OAUTH_YANDEX_ENABLED=0
OAUTH_YANDEX_CLIENT_ID=
OAUTH_YANDEX_CLIENT_SECRET=
OAUTH_YANDEX_REDIRECT_URI=http://localhost:8000/auth/oauth/yandex/callback

# ── PostgreSQL ────────────────────────────────────────────────
# В Level 3: credentials генерируются Vault динамически (TTL=1h)
# В Level 1: указать явно
DATABASE_URL=                 # пусто = Vault dynamic | или postgresql://user:pass@host/db

# Для Vault Database Engine (dynamic credentials):
DB_HOST=postgres
DB_PORT=5432
DB_NAME=sku_db

# ── Redis ─────────────────────────────────────────────────────
# Audit R3-15 — Redis can run with --requirepass when REDIS_PASSWORD
# is set (compose conditionally enables it). To use auth in dev:
#   1. set REDIS_PASSWORD below to a non-empty value
#   2. ALSO update REDIS_URL to embed the password as
#      redis://:${REDIS_PASSWORD}@redis:6379
# In staging/prod both vars come from Lockbox.
REDIS_URL=redis://redis:6379
REDIS_PASSWORD=

# ── Audit R3-14 — TRUSTED_PROXIES ─────────────────────────────
# Default in code is `127.0.0.0/8` (loopback only). When nginx
# fronts the api, override with the actual bridge CIDR so the
# X-Forwarded-For walk trusts only the proxy, e.g.:
#   TRUSTED_PROXIES=127.0.0.0/8,172.20.0.0/16
TRUSTED_PROXIES=

# ── MLflow ────────────────────────────────────────────────────
MLFLOW_TRACKING_URI=http://mlflow:5000

# ── Мониторинг ────────────────────────────────────────────────
ALERT_WEBHOOK_URL=            # Slack Incoming Webhook
WEBHOOK_IP_WHITELIST=         # IP через запятую, пусто = разрешить всем
GRAFANA_PASSWORD=             # пусто = берётся из Vault

# ── Config ───────────────────────────────────────────────────
CONFIG_PATH=configs/config.yaml

# ── Домен (опционально) ───────────────────────────────────────
# Если задан — Nginx использует его как server_name вместо IP.
# Также нужен для Let's Encrypt TLS сертификата.
# Пример: DOMAIN=api.mycompany.com
DOMAIN=

# ── Airflow (только для docker-compose.yml / local dev) ──────
# Генерация: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=
AIRFLOW_SECRET_KEY=
AIRFLOW_USER=admin
AIRFLOW_PASSWORD=
# Audit R3-13 — POSTGRES_PASSWORD now drives every DSN in compose
# (api/worker/pgbouncer/mlflow/airflow/backup). Single env-line rotates
# the password across all services. Compose falls back to literal `sku`
# if unset — that's a migration grace period; staging/prod will flip to
# strict `:?` once Lockbox is populated. Set a real value here for dev.
POSTGRES_PASSWORD=changeme-dev-only-use-lockbox-in-prod
MINIO_USER=
MINIO_PASSWORD=
