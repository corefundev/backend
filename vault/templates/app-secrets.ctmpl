{{- with secret "secret/data/sku-forecasting" -}}
JWT_SECRET_KEY={{ .Data.data.jwt_secret_key }}
API_KEY={{ .Data.data.api_key }}
GRAFANA_PASSWORD={{ .Data.data.grafana_password }}
ALERT_WEBHOOK_URL={{ .Data.data.alert_webhook_url }}
